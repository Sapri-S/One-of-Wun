---
/**
 * F7 — Paper Trading & 30% Crash Simulator (FR-05, US-05).
 * Scripted animation: $1,000 → $700 over ~1.5s with an SVG dip (instant with reduced motion),
 * then a 4-step coaching stepper, an optional example recovery, and an always-visible reset.
 * Pretend money only. Nothing is stored.
 */
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Term from '../../components/Term.astro';
import { t, tv, formatMoney, LOCALE, type Lang } from '../../i18n/utils';
import { START, BEFORE, OFFSETS, VIEW, pathFor, y } from './series';

interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = tv<{ title: string; body: string; term?: { id: string; label: string } }[]>(lang, 'practice.steps');
const i18n = {
  locale: LOCALE[lang],
  status: tv<Record<string, string>>(lang, 'practice.status'),
};
const baseY = y(START).toFixed(1);
---
<div class="sim" data-sim data-i18n={JSON.stringify(i18n)}>
  <div class="panel">
    <div class="panel-head">
      <h2 class="panel-title">{t(lang, 'practice.cardTitle')}</h2>
      <span class="tag">{t(lang, 'practice.pretend')}</span>
    </div>

    <p class="value-label">{t(lang, 'practice.valueLabel')}</p>
    <p class="value num" data-value data-state="ready">{formatMoney(START, lang)}</p>
    <p class="start num">{t(lang, 'practice.startValue', { amount: formatMoney(START, lang) })}</p>

    <svg class="chart" viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-label={t(lang, 'practice.chartLabel')} preserveAspectRatio="none">
      <line class="baseline" x1="0" x2={VIEW.w} y1={baseY} y2={baseY} />
      <path class="line line--before" d={pathFor(BEFORE, OFFSETS.before)} />
      <path class="line line--drop" data-line="drop" d="" />
      <path class="line line--recovery" data-line="recovery" d="" />
    </svg>

    <p class="status" data-status aria-live="polite">{i18n.status.ready}</p>

    <div class="controls">
      <Button data-simulate>
        <Icon name="arrow-down" size={20} />
        {t(lang, 'practice.simulate')}
      </Button>
      <Button variant="quiet" data-recover hidden>
        <Icon name="sprout" size={20} />
        {t(lang, 'practice.recovery')}
      </Button>
      <Button variant="quiet" data-reset>
        <Icon name="reset" size={20} />
        {t(lang, 'practice.reset')}
      </Button>
    </div>
    <div class="projection" data-projection hidden>
      <Disclaimer variant="projection" />
    </div>
  </div>

  <div class="coach" data-coach hidden>
    <h2 class="coach-title">{t(lang, 'practice.stepperTitle')}</h2>
    <ol class="coach-steps" role="list">
      {steps.map((s, i) => (
        <li class="coach-step" data-step={i} hidden={i !== 0}>
          <p class="step-of">{t(lang, 'practice.stepOf', { n: i + 1, total: steps.length })}</p>
          <h3 class="step-title" tabindex="-1">{s.title}</h3>
          <p class="step-body">{s.body}</p>
          {s.term && <p class="step-term"><Term id={s.term.id}>{s.term.label}</Term></p>}
        </li>
      ))}
    </ol>
    <div class="coach-nav">
      <Button variant="quiet" data-prev>
        <Icon name="chevron-left" size={20} />
        {t(lang, 'practice.back')}
      </Button>
      <Button data-next>
        {t(lang, 'practice.next')}
        <Icon name="chevron-right" size={20} />
      </Button>
    </div>
    <p class="done" data-done hidden>{t(lang, 'practice.doneNote')}</p>
  </div>
</div>

<script>
  import { START, BOTTOM, DROP, RECOVERY, OFFSETS, pathFor } from './series';

  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Value along a series at progress p (0–1), interpolating between points. */
  function valueAt(series: readonly number[], p: number): number {
    const pos = p * (series.length - 1);
    const i = Math.floor(pos);
    const next = series[Math.min(i + 1, series.length - 1)];
    return series[i] + (next - series[i]) * (pos - i);
  }

  document.querySelectorAll<HTMLElement>('[data-sim]').forEach((root) => {
    const i18n = JSON.parse(root.dataset.i18n || '{}');
    const money = new Intl.NumberFormat(i18n.locale, { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const $ = <T extends HTMLElement | SVGElement>(sel: string) => root.querySelector(sel) as T;

    const valueEl = $<HTMLElement>('[data-value]');
    const statusEl = $<HTMLElement>('[data-status]');
    const dropLine = $<SVGPathElement>('[data-line="drop"]');
    const recLine = $<SVGPathElement>('[data-line="recovery"]');
    const simulateBtn = $<HTMLButtonElement>('[data-simulate]');
    const recoverBtn = $<HTMLButtonElement>('[data-recover]');
    const resetBtn = $<HTMLButtonElement>('[data-reset]');
    const projection = $<HTMLElement>('[data-projection]');
    const coach = $<HTMLElement>('[data-coach]');
    const stepEls = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const prevBtn = $<HTMLButtonElement>('[data-prev]');
    const nextBtn = $<HTMLButtonElement>('[data-next]');
    const doneEl = $<HTMLElement>('[data-done]');

    let frame = 0;
    let step = 0;

    function animate(series: readonly number[], line: SVGPathElement, offset: number, ms: number, done: () => void) {
      cancelAnimationFrame(frame);
      if (reduce()) {
        line.setAttribute('d', pathFor(series, offset));
        valueEl.textContent = money.format(series[series.length - 1]);
        done();
        return;
      }
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / ms);
        const eased = 1 - Math.pow(1 - p, 2);
        line.setAttribute('d', pathFor(series, offset, eased));
        valueEl.textContent = money.format(valueAt(series, eased));
        if (p < 1) frame = requestAnimationFrame(tick);
        else done();
      };
      frame = requestAnimationFrame(tick);
    }

    function showStep(n: number, focus: boolean) {
      step = n;
      stepEls.forEach((el, i) => (el.hidden = i !== n));
      prevBtn.disabled = n === 0;
      const last = n === stepEls.length - 1;
      nextBtn.hidden = last;
      doneEl.hidden = !last;
      if (focus) {
        // Don't jump the page when the step is already on screen (desktop); scroll only if needed (mobile).
        const title = stepEls[n].querySelector<HTMLElement>('.step-title');
        title?.focus({ preventScroll: true });
        title?.scrollIntoView({ block: 'nearest', behavior: reduce() ? 'auto' : 'smooth' });
      }
    }

    simulateBtn.addEventListener('click', () => {
      simulateBtn.disabled = true;
      valueEl.dataset.state = 'dropping';
      statusEl.textContent = i18n.status.dropping;
      animate(DROP, dropLine, OFFSETS.drop, 1500, () => {
        valueEl.textContent = money.format(BOTTOM);
        valueEl.dataset.state = 'dropped';
        statusEl.textContent = i18n.status.dropped;
        coach.hidden = false;
        recoverBtn.hidden = false;
        showStep(0, true);
      });
    });

    recoverBtn.addEventListener('click', () => {
      recoverBtn.disabled = true;
      projection.hidden = false;
      valueEl.dataset.state = 'recovering';
      statusEl.textContent = i18n.status.recovering;
      animate(RECOVERY, recLine, OFFSETS.recovery, 2000, () => {
        valueEl.dataset.state = 'recovered';
        statusEl.textContent = i18n.status.recovered;
      });
    });

    prevBtn.addEventListener('click', () => showStep(Math.max(0, step - 1), true));
    nextBtn.addEventListener('click', () => showStep(Math.min(stepEls.length - 1, step + 1), true));

    resetBtn.addEventListener('click', () => {
      cancelAnimationFrame(frame);
      dropLine.setAttribute('d', '');
      recLine.setAttribute('d', '');
      valueEl.textContent = money.format(START);
      valueEl.dataset.state = 'ready';
      statusEl.textContent = i18n.status.ready;
      simulateBtn.disabled = false;
      recoverBtn.disabled = false;
      recoverBtn.hidden = true;
      projection.hidden = true;
      coach.hidden = true;
      showStep(0, false);
      simulateBtn.focus();
    });
  });
</script>

<style>
  /* The shared .btn sets display:inline-flex, which would beat the `hidden` attribute. */
  .sim :global([hidden]) { display: none !important; }
  .sim {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 960px) {
    .sim { grid-template-columns: 3fr 2fr; }
  }
  .panel, .coach {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow);
    min-width: 0;
  }
  @media (min-width: 768px) {
    .panel, .coach { padding: var(--space-6); }
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }
  .panel-title, .coach-title { font-size: var(--fs-h3); }
  .tag {
    padding: 2px 12px;
    border-radius: var(--radius-pill);
    background: var(--surface-mist);
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .value-label { margin-top: var(--space-4); color: var(--ink-soft); font-size: var(--fs-small); }
  .value {
    font-size: clamp(2.5rem, 2rem + 2.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
    transition: color var(--dur) var(--ease);
  }
  .value[data-state='dropping'], .value[data-state='dropped'] { color: var(--stop-ink); }
  .value[data-state='recovered'] { color: var(--go-ink); }
  .start { color: var(--ink-muted); font-size: var(--fs-small); }

  .chart {
    width: 100%;
    height: 160px;
    margin-top: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-sage);
    overflow: visible;
  }
  .baseline { stroke: var(--ink-muted); stroke-width: 1; stroke-dasharray: 4 4; vector-effect: non-scaling-stroke; }
  .line { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .line--before { stroke: var(--primary); }
  .line--drop { stroke: var(--stop-ink); }
  .line--recovery { stroke: var(--go-ink); stroke-dasharray: 6 5; }

  .status { margin-top: var(--space-4); font-weight: 700; min-height: 3.2em; }
  .controls { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .projection { margin-top: var(--space-4); }

  .coach-steps { list-style: none; padding: 0; margin-top: var(--space-4); }
  .coach-step { max-width: none; animation: step-in var(--dur) var(--ease); }
  .step-of { color: var(--ink-muted); font-size: var(--fs-small); font-weight: 700; }
  .step-title { margin-block: var(--space-1) var(--space-2); }
  .step-title:focus { outline: none; }
  .step-title:focus-visible { outline: 3px solid var(--focus); }
  .step-body { color: var(--ink-soft); }
  .step-term { margin-top: var(--space-2); font-size: var(--fs-small); }
  .coach-nav { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .done { margin-top: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--surface-sage); }
  @keyframes step-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
</style>
