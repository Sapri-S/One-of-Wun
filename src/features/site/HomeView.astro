---
/**
 * Home: one question first ("What would you like to do today?"), then the example path, then the ideas.
 * Every page is 1 click from here (3-click rule).
 */
import BaseLayout from '../../components/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Term from '../../components/Term.astro';
import Roadmap from '../roadmap/Roadmap.astro';
import { t, tv, localizePath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const toyota = tv<{ name: string; plain: string; body: string }[]>(lang, 'home.toyota.cards');
const toyotaIcons = ['steps', 'gate', 'pause'] as const;
const toyotaTerms = ['kaizen', 'jidoka', 'andon'];
const tasks = [
  { key: 'next', href: localizePath('/next-step', lang), icon: 'gate' },
  { key: 'grow', href: localizePath('/grow', lang), icon: 'sprout' },
  { key: 'learn', href: localizePath('/learn', lang), icon: 'book' },
  { key: 'help', href: localizePath('/help', lang), icon: 'lifebuoy' },
] as const;
---
<BaseLayout title={t(lang, 'home.meta.title')} description={t(lang, 'home.meta.description')} lang={lang}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title">{t(lang, 'home.hero.title')}</h1>
      <p class="lead">{t(lang, 'home.hero.lead')}</p>

      <h2 class="ask" id="tasks-title">{t(lang, 'home.hero.ask')}</h2>
      <ul class="tasks" aria-labelledby="tasks-title">
        {tasks.map((task, i) => (
          <li>
            <a class:list={['task', { 'task--main': i === 0 }]} href={task.href}>
              <span class="task-icon"><Icon name={task.icon} size={28} /></span>
              <span class="task-text">
                <span class="task-title">{t(lang, `home.tasks.${task.key}.title`)}</span>
                <span class="task-body">{t(lang, `home.tasks.${task.key}.body`)}</span>
                <span class="task-time">{t(lang, `home.tasks.${task.key}.time`)}</span>
              </span>
              <Icon name="chevron-right" class="task-chev" />
            </a>
          </li>
        ))}
      </ul>

      <div class="more">
        <span class="more-label">{t(lang, 'home.hero.more')}</span>
        <a href={localizePath('/practice', lang)}><Icon name="practice" size={20} />{t(lang, 'home.tasks.practice')}</a>
        <a href={localizePath('/your-path', lang)}><Icon name="route" size={20} />{t(lang, 'home.tasks.path')}</a>
      </div>
    </div>
  </section>

  <Section id="roadmap" tone="sage" title={t(lang, 'home.roadmap.title')} badge="education" intro={t(lang, 'home.roadmap.intro')}>
    <Roadmap lang={lang} mode="demo" />
    <div class="try">
      <p>{t(lang, 'home.roadmap.tryYours')}</p>
      <Button href={localizePath('/next-step', lang)}>{t(lang, 'home.roadmap.tryYoursLink')}</Button>
    </div>
  </Section>

  <Section id="ideas" title={t(lang, 'home.toyota.title')} badge="education" intro={t(lang, 'home.toyota.intro')}>
    <ul class="ideas">
      {toyota.map((c, i) => (
        <li>
          <Card title={c.plain} tone="plain">
            <span slot="top" class="idea-top">
              <span class="idea-icon"><Icon name={toyotaIcons[i]} /></span>
              <Term id={toyotaTerms[i]}>{c.name}</Term>
            </span>
            <p>{c.body}</p>
          </Card>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); }
  .hero h1 { max-width: 18ch; }
  .lead { margin-top: var(--space-3); font-size: 1.25rem; color: var(--ink-soft); }
  .ask { margin-top: var(--space-6); font-size: var(--fs-h3); }

  .tasks {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    list-style: none;
    padding: 0;
  }
  .tasks > li { max-width: none; }
  .task {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 2px solid var(--border);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .task:hover { border-color: var(--primary); box-shadow: var(--shadow); }
  .task--main { border-color: var(--primary); background: var(--surface-sage); }
  .task-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface-sage);
    color: var(--primary);
  }
  .task--main .task-icon { background: var(--primary); color: var(--on-primary); }
  .task-text { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; }
  .task-title { font-weight: 700; font-size: 1.25rem; line-height: 1.25; }
  .task-body { color: var(--ink-soft); font-size: var(--fs-small); }
  .task-time { color: var(--ink-muted); font-size: var(--fs-small); }
  .task :global(.task-chev) { color: var(--primary); }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }
  .more-label { color: var(--ink-muted); font-size: var(--fs-small); }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    font-weight: 700;
  }

  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }
  .try p { font-weight: 700; }

  .ideas {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
  .ideas > li { max-width: none; }
  .idea-top { display: flex; align-items: center; gap: var(--space-3); font-weight: 700; color: var(--accent); }
  .idea-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-sage);
    color: var(--primary);
  }

  @media (min-width: 768px) {
    .hero { padding-block: var(--space-8); }
    .ask { margin-top: var(--space-7); }
    .task { padding: var(--space-5); }
    .task-icon { width: 56px; height: 56px; }
    .tasks { grid-template-columns: repeat(2, 1fr); }
    .ideas { grid-template-columns: repeat(3, 1fr); }
  }
</style>
