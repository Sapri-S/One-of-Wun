---
/**
 * F2 — guided Ready-to-Invest check (FR-02). One question at a time → light + next step,
 * then places the visitor on the personal roadmap (if one is on the page).
 * Answers live only in the page; nothing is stored.
 */
import Icon from '../../components/Icon.astro';
import Term from '../../components/Term.astro';
import Button from '../../components/Button.astro';
import { t, tv, localizePath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const qs = tv<{ q: string; hint: string }[]>(lang, 'next.questions');
// Order matches logic.ts fields.
const fields = ['highInterestDebt', 'hasThousandSaved', 'billsCovered'] as const;

const i18n = {
  progress: t(lang, 'next.progress'),
  status: tv<Record<string, string>>(lang, 'common.status'),
  results: tv<Record<string, string>>(lang, 'next.results'),
  buttons: tv<Record<string, string>>(lang, 'next.nextButtons'),
  milestones: tv<{ title: string }[]>(lang, 'home.roadmap.milestones').map((m) => m.title),
  links: {
    stop: localizePath('/help', lang),
    wait: localizePath('/grow', lang),
    go: localizePath('/learn', lang),
  },
};
---
<div class="guided" data-guided data-i18n={JSON.stringify(i18n)}>
  <div class="asking" data-asking>
    <div class="progress">
      <p class="progress-text" data-progress>{t(lang, 'next.progress', { n: 1, total: 3 })}</p>
      <ol class="dots" aria-hidden="true">
        {qs.map((_, i) => <li class:list={{ on: i === 0 }} data-dot={i}></li>)}
      </ol>
    </div>

    {qs.map((q, i) => (
      <div class="q" data-q={i} hidden={i !== 0}>
        <h2 class="q-text" id={`rq-${i}`} tabindex="-1">
          {i === 0 ? (
            <Fragment>{q.q.split('APR')[0]}<Term id="apr">APR</Term>{q.q.split('APR')[1]}</Fragment>
          ) : q.q}
        </h2>
        <p class="q-hint" id={`rq-hint-${i}`}>{q.hint}</p>
        <div class="choices" role="group" aria-labelledby={`rq-${i}`} aria-describedby={`rq-hint-${i}`}>
          {(['yes', 'no'] as const).map((v) => (
            <button type="button" class="choice" data-field={fields[i]} data-answer={v} aria-pressed="false">
              {t(lang, `next.${v}`)}
            </button>
          ))}
        </div>
      </div>
    ))}

    <button type="button" class="back" data-back hidden>
      <Icon name="chevron-left" size={20} />
      {t(lang, 'next.back')}
    </button>
  </div>

  <div class="result" data-result data-state="stop" hidden>
    <p class="result-kicker">{t(lang, 'next.lightTitle')}</p>
    <div class="light-row">
      <span class="light" aria-hidden="true">
        <span class="lamp lamp--stop"></span>
        <span class="lamp lamp--wait"></span>
        <span class="lamp lamp--go"></span>
      </span>
      <h2 class="result-title" data-result-title tabindex="-1"></h2>
    </div>
    <p class="result-body" data-result-body></p>
    <div class="next-step">
      <p class="next-label">{t(lang, 'next.nextStepLabel')}</p>
      <p class="next-title" data-next-title></p>
    </div>
    <div class="actions">
      <Button href="#" data-result-link>…</Button>
      <Button variant="quiet" data-reset>
        <Icon name="reset" size={20} />
        {t(lang, 'next.startOver')}
      </Button>
    </div>
  </div>
</div>

<script>
  import { evaluate, placeOnPath, type Answers } from './logic';

  document.querySelectorAll<HTMLElement>('[data-guided]').forEach((root) => {
    const i18n = JSON.parse(root.dataset.i18n || '{}');
    const asking = root.querySelector<HTMLElement>('[data-asking]')!;
    const qs = Array.from(root.querySelectorAll<HTMLElement>('[data-q]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const link = root.querySelector<HTMLAnchorElement>('[data-result-link]')!;
    const placement = document.querySelector<HTMLElement>('[data-placement]');
    const roadmap = document.querySelector<HTMLElement>('[data-roadmap][data-mode="personal"]');

    const answers: Answers = { highInterestDebt: null, hasThousandSaved: null, billsCovered: null };
    let step = 0;

    function show(i: number, focus = true) {
      step = i;
      qs.forEach((q, j) => (q.hidden = j !== i));
      dots.forEach((d, j) => d.classList.toggle('on', j <= i));
      root.querySelector('[data-progress]')!.textContent = i18n.progress.replace('{n}', String(i + 1)).replace('{total}', String(qs.length));
      back.hidden = i === 0;
      if (focus) qs[i].querySelector<HTMLElement>('.q-text')!.focus();
    }

    function finish() {
      const r = evaluate(answers)!;
      const place = placeOnPath(answers)!;
      asking.hidden = true;
      result.hidden = false;
      result.dataset.state = r.status;
      const key = r.status === 'stop' ? (r.reason === 'bills' ? 'stopBills' : 'stopDebt') : r.status;
      root.querySelector('[data-result-title]')!.textContent = i18n.status[r.status];
      root.querySelector('[data-result-body]')!.textContent = i18n.results[key];
      root.querySelector('[data-next-title]')!.textContent = `${place.current + 1}. ${i18n.milestones[place.current]}`;
      link.textContent = i18n.buttons[r.status];
      link.href = i18n.links[r.status];
      if (placement && roadmap) {
        placement.hidden = false;
        roadmap.dispatchEvent(new CustomEvent('roadmap:place', { detail: place }));
      }
      root.querySelector<HTMLElement>('[data-result-title]')!.focus();
    }

    function reset() {
      (Object.keys(answers) as (keyof Answers)[]).forEach((k) => (answers[k] = null));
      root.querySelectorAll('[data-answer]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      result.hidden = true;
      asking.hidden = false;
      if (placement) placement.hidden = true;
      show(0);
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const choice = target.closest<HTMLButtonElement>('[data-answer]');
      if (choice) {
        const field = choice.dataset.field as keyof Answers;
        answers[field] = choice.dataset.answer === 'yes';
        choice.parentElement!.querySelectorAll('[data-answer]').forEach((b) => b.setAttribute('aria-pressed', String(b === choice)));
        if (step < qs.length - 1) show(step + 1);
        else finish();
        return;
      }
      if (target.closest('[data-back]')) return show(Math.max(0, step - 1));
      if (target.closest('[data-reset]')) return reset();
    });
  });
</script>

<style>
  .guided {
    max-width: 720px;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .progress { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .progress-text { font-weight: 700; color: var(--ink-soft); font-size: var(--fs-small); }
  .dots { display: flex; gap: var(--space-2); list-style: none; padding: 0; }
  .dots li {
    width: 36px;
    height: 8px;
    border-radius: 4px;
    background: var(--surface-sage);
    transition: background-color var(--dur) var(--ease);
  }
  .dots li.on { background: var(--primary); }

  .q { margin-top: var(--space-5); }
  .q:not([hidden]) { animation: q-in var(--dur) var(--ease); }
  .q-text { font-size: var(--fs-h3); line-height: 1.3; }
  .q-text:focus { outline: none; }
  .q-text:focus-visible { outline: 3px solid var(--focus); }
  .q-hint { margin-top: var(--space-2); color: var(--ink-muted); }
  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .choice {
    min-height: 64px;
    border-radius: var(--radius);
    border: 2px solid var(--border);
    background: var(--bg);
    font-size: 1.25rem;
    font-weight: 700;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .choice:hover { border-color: var(--primary); }
  .choice[aria-pressed='true'] { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    margin-top: var(--space-4);
    padding: 0 var(--space-3) 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--accent);
    font-weight: 700;
  }
  .back[hidden] { display: none; }

  .result:not([hidden]) { animation: q-in var(--dur) var(--ease); }
  .result-kicker { color: var(--ink-muted); font-weight: 700; font-size: var(--fs-small); }
  .light-row { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-3); }
  .light {
    display: inline-flex;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .lamp { width: 22px; height: 22px; border-radius: 50%; background: var(--border); }
  [data-state='stop'] .lamp--stop { background: var(--stop-ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--stop-ink) 20%, transparent); }
  [data-state='wait'] .lamp--wait { background: var(--wait-ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--wait-ink) 20%, transparent); }
  [data-state='go'] .lamp--go { background: var(--go-ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--go-ink) 20%, transparent); }
  .result-title { font-size: var(--fs-h3); line-height: 1.25; }
  .result-title:focus { outline: none; }
  [data-state='stop'] .result-title { color: var(--stop-ink); }
  [data-state='wait'] .result-title { color: var(--wait-ink); }
  [data-state='go'] .result-title { color: var(--go-ink); }
  .result-body { margin-top: var(--space-3); }
  .next-step {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    background: var(--surface-sage);
  }
  .next-label { font-size: var(--fs-small); color: var(--ink-soft); font-weight: 700; }
  .next-title { font-size: 1.25rem; font-weight: 700; color: var(--primary); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  @keyframes q-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>
