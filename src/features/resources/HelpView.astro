---
/** /help — Trusted Resources & FAQ (F9). Part 2. */
import BaseLayout from '../../components/BaseLayout.astro';
import Section from '../../components/Section.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Icon from '../../components/Icon.astro';
import ResourceFinder from './ResourceFinder.astro';
import { t, type Lang } from '../../i18n/utils';
import faqEn from '../../content/faq.en.json';
import faqEs from '../../content/faq.es.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const faq = lang === 'es' ? faqEs : faqEn;
---
<BaseLayout title={t(lang, 'help.meta.title')} description={t(lang, 'help.meta.description')} lang={lang}>
  <Section id="resources" level={1} title={t(lang, 'help.title')} badge="your-choice" intro={t(lang, 'help.lead')}>
    <div class="otp-wrap">
      <OnThisPage items={[{ id: 'faq', label: t(lang, 'help.otp.faq') }]} />
    </div>
    <ResourceFinder lang={lang} />
  </Section>

  <Section id="faq" tone="sage" title={t(lang, 'help.faqTitle')} badge="education" intro={t(lang, 'help.faqIntro')}>
    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <span class="chev"><Icon name="chevron-right" size={22} /></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .otp-wrap { margin-bottom: var(--space-6); }
  .faq { display: grid; gap: var(--space-3); max-width: 820px; }
  details {
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: var(--space-3) var(--space-5);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--primary); }
  .chev { display: grid; color: var(--primary); transition: transform var(--dur) var(--ease); }
  details[open] .chev { transform: rotate(90deg); }
  details p { padding: 0 var(--space-5) var(--space-5); color: var(--ink-soft); }
</style>
