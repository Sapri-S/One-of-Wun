---
/**
 * Readiness status with colour + icon + text (never colour alone).
 * <StatusPill status="stop" label="Pause and fix this first" />
 * For live updates from JS, toggle the class `status--stop|wait|go` and swap the text in `.status-label`.
 */
import Icon from './Icon.astro';
interface Props {
  status: 'stop' | 'wait' | 'go';
  label: string;
  id?: string;
}
const { status, label, id } = Astro.props;
---
<span class:list={['status', `status--${status}`]} id={id} data-status={status}>
  <span class="status-icon status-icon--stop"><Icon name="pause" size={20} /></span>
  <span class="status-icon status-icon--wait"><Icon name="hourglass" size={20} /></span>
  <span class="status-icon status-icon--go"><Icon name="check" size={20} /></span>
  <span class="status-label">{label}</span>
</span>

<style is:global>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 16px 8px 10px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    line-height: 1.3;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .status-icon {
    display: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
  }
  .status--stop { background: var(--stop-bg); color: var(--stop-ink); }
  .status--wait { background: var(--wait-bg); color: var(--wait-ink); }
  .status--go { background: var(--go-bg); color: var(--go-ink); }
  .status--stop .status-icon--stop,
  .status--wait .status-icon--wait,
  .status--go .status-icon--go { display: grid; }
</style>
