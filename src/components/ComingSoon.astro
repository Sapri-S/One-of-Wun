---
/**
 * Placeholder used by Part 2 route stubs until Part 2 replaces them. Safe to delete afterwards.
 * <ComingSoon lang={lang} pageKey="learn" />
 */
import BaseLayout from './BaseLayout.astro';
import Section from './Section.astro';
import Button from './Button.astro';
import { t, localizePath, type Lang, type PageKey } from '../i18n/utils';

interface Props { lang: Lang; pageKey: PageKey }
const { lang, pageKey } = Astro.props;
const title = t(lang, `common.nav.${pageKey}`);
---
<BaseLayout title={title} description={t(lang, 'common.comingSoon.body')} lang={lang}>
  <Section id="coming-soon" level={1} title={title} badge="education" intro={t(lang, 'common.comingSoon.title')}>
    <p>{t(lang, 'common.comingSoon.body')}</p>
    <p class="actions">
      <Button href={localizePath('/', lang)}>{t(lang, 'common.nav.home')}</Button>
      <Button href={localizePath('/grow', lang)} variant="quiet">{t(lang, 'common.nav.grow')}</Button>
    </p>
  </Section>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
</style>
