---
/**
 * Calm content card.
 * <Card title="Index funds" tone="plain">…</Card>
 * Slot "top" renders above the title (for a badge or icon).
 */
interface Props {
  title: string;
  tone?: 'plain' | 'sage' | 'mist';
  /** Heading level for the title. Default 3. */
  level?: 2 | 3 | 4;
  id?: string;
}
const { title, tone = 'plain', level = 3, id } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<article class:list={['card', `card--${tone}`]} id={id}>
  {Astro.slots.has('top') && <div class="top"><slot name="top" /></div>}
  <H class="card-title">{title}</H>
  <div class="card-body"><slot /></div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow);
  }
  .card--sage { background: var(--surface-sage); box-shadow: none; }
  .card--mist { background: var(--surface-mist); box-shadow: none; }
  .top { margin-bottom: var(--space-3); }
  .card-title { font-size: var(--fs-h3); }
  .card-body { margin-top: var(--space-3); color: var(--ink-soft); }
  .card-body > :global(* + *) { margin-top: var(--space-3); }
</style>
