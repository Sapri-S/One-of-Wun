---
/**
 * Page shell: <head>, skip link, header + nav, education strip, footer, service worker.
 * Usage: <BaseLayout title="Learn" description="…" lang={lang}> …sections… </BaseLayout>
 */
import '../styles/global.css';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './Icon.astro';
import { getLang, t, localizePath, stripLang, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}
const { title, description } = Astro.props;
const lang = Astro.props.lang ?? getLang(Astro.url);
const siteName = t(lang, 'common.siteName');
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const basePath = stripLang(Astro.url.pathname);
const site = Astro.site ?? new URL('https://example.com');
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F6F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141B19" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <link rel="alternate" hreflang="en" href={new URL(localizePath(basePath, 'en'), site)} />
    <link rel="alternate" hreflang="es" href={new URL(localizePath(basePath, 'es'), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(basePath, 'en'), site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'common.skip')}</a>
    <SiteHeader lang={lang} />
    <p class="edu-strip">
      <Icon name="info" size={18} />
      <span>{t(lang, 'common.eduStrip')}</span>
    </p>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<script>
  if ('serviceWorker' in navigator && import.meta.env.PROD) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* offline support is a bonus; the site works without it */
      });
    });
  }
</script>

<style>
  .edu-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-width: none;
    padding: var(--space-2) var(--gutter);
    background: var(--surface-mist);
    color: var(--ink-soft);
    font-size: var(--fs-small);
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  main:focus { outline: none; }
  main {
    /* room for the mobile bottom tab bar */
    padding-bottom: 88px;
  }
  @media (min-width: 1280px) {
    main { padding-bottom: 0; }
  }
</style>
